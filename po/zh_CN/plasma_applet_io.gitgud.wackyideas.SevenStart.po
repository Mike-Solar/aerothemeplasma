msgid "General"
msgstr "常规"

msgid "Side panel"
msgstr "侧边面板"

msgid "Orb texture"
msgstr "球体纹理"

msgid "Orb size (0 for default/no scaling):"
msgstr "球体大小（0 表示默认/不缩放）："

msgid "Behavior"
msgstr "行为"

msgid "Show applications as:"
msgstr "应用显示方式："

msgid "Description (Name)"
msgstr "描述（名称）"

msgid "Description only"
msgstr "仅描述"

msgid "Name (Description)"
msgstr "名称（描述）"

msgid "Name only"
msgstr "仅名称"

msgid "Switch categories on hover"
msgstr "悬停时切换分类"

msgid "Expand search to bookmarks, files and emails"
msgstr "将搜索扩展到书签、文件和电子邮件"

msgid "Enable floating orb for shorter taskbars"
msgstr "为较短的任务栏启用浮动球体"

msgid "Show recent programs"
msgstr "显示最近使用的程序"

msgid "Display full name"
msgstr "显示全名"

msgid "Display generic folder icons for categories"
msgstr "为分类显示通用文件夹图标"

msgid "Number of recent programs to display:"
msgstr "显示的最近程序数量："

msgid "Tweaks"
msgstr "微调"

msgid "Apply uneven padding on the search text box"
msgstr "在搜索文本框上应用不对称内边距"

msgid "Offset floating orb into the taskbar"
msgstr "将浮动球体偏移到任务栏内"

msgid "Enable shadow"
msgstr "启用阴影"

msgid "Choose runner for the 'Run' entry"
msgstr "为“运行”项选择运行器"

msgid "KRunner"
msgstr "KRunner"

msgid "Execbin"
msgstr "Execbin"

msgid "Customize how links, icons, and menus look and behave."
msgstr "自定义链接、图标和菜单的外观与行为。"

msgid "Pin to taskbar"
msgstr "固定到任务栏"

msgid "Unpin from taskbar"
msgstr "从任务栏取消固定"

msgctxt "@item:inmenu Open icon chooser dialog"
msgid "Choose..."
msgstr "选择..."

msgctxt "@item:inmenu Reset icon to default"
msgid "Reset"
msgstr "重置"

msgid " Search programs and files"
msgstr " 搜索程序和文件"

msgid "Closes all open programs, shuts down Linux, and then turns off your computer."
msgstr "关闭所有打开的程序，关闭 Linux，然后关闭计算机。"

msgid "Shut down"
msgstr "关机"

msgid "Home directory"
msgstr "主目录"

msgid "Open your personal folder."
msgstr "打开您的个人文件夹。"

msgid "Documents"
msgstr "文档"

msgid "Access letters, reports, notes and other kinds of documents."
msgstr "访问信件、报告、笔记及其他类型的文档。"

msgid "Pictures"
msgstr "图片"

msgid "View and organize digital pictures"
msgstr "查看并整理数字图片"

msgid "Music"
msgstr "音乐"

msgid "Play music and other audio files."
msgstr "播放音乐和其他音频文件。"

msgid "Videos"
msgstr "视频"

msgid "Watch home movies and other digital videos."
msgstr "观看家庭影片和其他数字视频。"

msgid "Downloads"
msgstr "下载"

msgid "Find Internet downloads and links to favorite websites."
msgstr "查找 Internet 下载内容和收藏网站的链接。"

msgid "Games"
msgstr "游戏"

msgid "Play and manage games on your computer."
msgstr "在计算机上玩和管理游戏。"

msgid "Recent Items"
msgstr "最近使用的项目"

msgid "Computer"
msgstr "计算机"

msgid "See the disk drives and other hardware connected to your computer."
msgstr "查看连接到计算机的磁盘驱动器和其他硬件。"

msgid "Network"
msgstr "网络"

msgid "Access the computers and devices that are on your network."
msgstr "访问网络上的计算机和设备。"

msgid "Control Panel"
msgstr "控制面板"

msgid "Change settings and customize the functionality of your computer."
msgstr "更改设置并自定义计算机的功能。"

msgid "Devices and Printers"
msgstr "设备和打印机"

msgid "View and manage devices, printers and print jobs"
msgstr "查看并管理设备、打印机和打印任务"

msgid "Default Programs"
msgstr "默认程序"

msgid "Choose default programs for web browsing, e-mail, playing music, and other activities."
msgstr "为网页浏览、电子邮件、播放音乐和其他“活动”选择默认程序。"

msgid "Help and Support"
msgstr "帮助和支持"

msgid "Find Help topics, tutorials, troubleshooting, and other support services."
msgstr "查找帮助主题、教程、疑难解答和其他支持服务。"

msgid "Run"
msgstr "运行"

msgid "Run..."
msgstr "运行..."

msgid "Opens a program, folder, document, or web site."
msgstr "打开程序、文件夹、文档或网站。"

msgid "Start"
msgstr "开始"

msgid "Edit Applications..."
msgstr "编辑应用程序..."

msgid "Task Manager"
msgstr "任务管理器"
